                  "const defaultTrendModel = json.find((model) => model.prediction_kind === 'trend' && model.is_default) || json.find((model) => model.prediction_kind === 'trend') || json[0];",
                  "pm.environment.set('modelCode', defaultPriceModel.code);",
                  "pm.environment.set('trendModelCode', defaultTrendModel.code);"
                ],
