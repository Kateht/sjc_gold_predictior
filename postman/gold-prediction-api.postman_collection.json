              "raw": "{\n  \"task\": \"report\",\n  \"quiet\": true\n}"
            },
            "url": "{{baseUrl}}/admin/crawler/runs"
          }
        },
        {
          "name": "Get Crawler Run Detail",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "const expectedId = Number(pm.environment.get('crawlerRunId'));",
                  "let attempts = Number(pm.environment.get('crawlerPollAttempts') || '0');",
                  "const maxAttempts = 15;",
                  "pm.test('Run detail exists', function () { pm.expect(json).to.have.property('id'); });",
                  "pm.test('Run id matches', function () { pm.expect(json.id).to.eql(expectedId); });",
                  "pm.test('Crawler status is valid', function () {",
                  "  pm.expect(['pending', 'running', 'success', 'failed']).to.include(json.status);",
                  "});",
                  "if (!['success', 'failed'].includes(json.status) && attempts < maxAttempts) {",
                  "  attempts += 1;",
                  "  pm.environment.set('crawlerPollAttempts', String(attempts));",
                  "  pm.execution.setNextRequest('Get Crawler Run Detail');",
                  "} else {",
                  "  pm.environment.unset('crawlerPollAttempts');",
                  "  pm.test('Crawler run reaches success', function () { pm.expect(json.status).to.eql('success'); });",
                  "  pm.test('Crawler exit code is zero', function () { pm.expect(json.exit_code).to.eql(0); });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/crawler/runs/{{crawlerRunId}}"
          }
        }
      ]
    }
  ]
}