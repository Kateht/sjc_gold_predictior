    {
      "name": "Market",
      "item": [
        {
          "name": "Price Chart",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Dates and prices exist', function () {",
                  "  pm.expect(json).to.have.property('dates');",
                  "  pm.expect(json).to.have.property('prices');",
                  "  pm.expect(json.dates.length).to.eql(json.prices.length);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/price-chart?range=30d&source=sjc"
          }
        },
        {
          "name": "Predict Price",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Prediction shape is valid', function () {",
                  "  pm.expect(json.future_dates.length).to.eql(json.predictions.length);",
                  "  pm.expect(json).to.have.property('selected_model');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/predict?days=7&model={{modelCode}}&source=sjc"
          }
        },
        {
          "name": "Predict Trend",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('Trend payload is valid', function () {",
                  "  pm.expect(json.future_dates.length).to.eql(json.trend_predictions.length);",
                  "  pm.expect(json.future_dates.length).to.eql(json.trend_scores.length);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/predict/trend?days=7&model={{trendModelCode}}&source=sjc"
          }
        },
